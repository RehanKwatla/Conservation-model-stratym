    "note": "Callers pass RAW (unscaled) features; the policy scales internally."
  },
  "static_input": {
    "name": "static",
    "shape": [
      "batch",
      12
    ],
    "extras_note": "indices 0-7 identical to SP-02/03/04; indices 8-11 (portfolio drawdown, gross exposure, position size, recent loss) are SP-05 additions; every extra defaults to 0 when absent",
    "dtype": "float32",
    "features": [
      {
        "index": 0,
        "name": "pos_flat"
      },
      {
        "index": 1,
        "name": "pos_long"
      },
      {
        "index": 2,
        "name": "pos_short"
      },
      {
        "index": 3,
        "name": "risk_tolerance"
      },
      {
        "index": 4,
        "name": "patience"
      },
      {
        "index": 5,
        "name": "aggressiveness"
      },
      {
        "index": 6,
        "name": "unrealized_pnl_scaled"
      },
      {
        "index": 7,
        "name": "holding_bars_scaled"
      },
      {
        "index": 8,
        "name": "portfolio_drawdown_scaled"
      },
      {
        "index": 9,
        "name": "gross_exposure_scaled"
      },
      {
        "index": 10,
        "name": "position_size_scaled"
      },
      {
        "index": 11,
        "name": "recent_loss_scaled"
      }
    ],
    "position_encoding": {
      "one_hot_order": [
        "pos_flat",
        "pos_long",
        "pos_short"
      ],
      "position_values": [
        0,
        1,
        -1
      ]
    },
    "profile_ranges": {
      "risk_tolerance": [
        0.0,
        1.0
      ],
      "patience": [
        0.0,
        1.0
      ],
      "aggressiveness": [
        0.0,
        1.0
      ]
    },
    "default_profile": {
      "risk_tolerance": 0.5,
      "patience": 0.5,
      "aggressiveness": 0.5
    }
  },
  "output": {
    "action_probs": [
      "batch",
      4
    ],
    "action_space": {
      "0": "HOLD",
      "1": "BUY",
      "2": "SELL",
      "3": "EXIT"
    },
    "confidence": "temperature-calibrated probability of the chosen action after masking invalid actions"
  },
  "valid_actions": {
    "flat": [
      "HOLD",
      "BUY",
      "SELL (only if allow_short)"
    ],
    "long": [
      "HOLD",
      "EXIT"
    ],
    "short": [
      "HOLD",
      "EXIT"
    ]
  },
  "execution_convention": "decision at close of bar t; fill at open of bar t+1",
  "compatibility": {
    "family_rule": "every SP-0x policy consumes the shared base features first, then its own extras; extras DIFFER per policy, so select columns by name",
    "shared_sequence_features": [
      "ret_1",
      "logret_1",
      "ret_5",
      "ret_10",
      "ret_20",
      "ret_60",
      "rsi_14",
      "macd_pct",
      "macd_signal_pct",
      "macd_hist_pct",
      "close_ema20",
      "close_ema50",
      "ema20_ema50",
      "close_sma200",
      "sma50_sma200",
      "adx_14",
      "di_diff",
      "atr_pct",
      "rv_20",
      "rv_60",
      "vol_chg_1",
      "vol_ratio_20",
      "vol_z_60",
      "hl_range",
      "gap_open",
      "close_loc",
      "rel_strength_20",
      "rel_strength_60",
      "bench_ret_20",
      "bench_rv_20"
    ],
    "sp05_extra_sequence_features": [
      "atr_pct_pctile_252",
      "rv20_pctile_252",
      "dd_from_high_60",
      "dd_from_high_252",
      "maxdd_60",
      "gap_abs_atr",
      "abnormal_ret_z",
      "range_z",
      "vol_anomaly_z",
      "bb_width_20",
      "down_vol_20",
      "bench_dd_60",
      "bench_rv20_pctile_252"
    ],
    "shared_static_features": [
      "pos_flat",
      "pos_long",
      "pos_short",
      "risk_tolerance",
      "patience",
      "aggressiveness",
      "unrealized_pnl_scaled",
      "holding_bars_scaled"
    ],
    "sp05_extra_static_features": [
      "portfolio_drawdown_scaled",
      "gross_exposure_scaled",
      "position_size_scaled",
      "recent_loss_scaled"
    ],
    "state_dict_keys": [
      "sequence",
      "position",
      "profile",
      "unrealized_pnl (optional)",
      "holding_bars (optional)",
      "risk_features (SP-05; from RiskFeatureAdapter)",
      "portfolio_drawdown (optional)",
      "gross_exposure (optional)",
      "position_size (optional)",
      "recent_loss (optional)"
    ],
    "adapter": {
      "class": "RiskFeatureAdapter",
      "input": "stock and benchmark OHLCV history ending at the decision bar (>= seq_len + 290 bars)",
      "output": "risk_features (L, 13)",
      "alternative": "pass sequence already extended to 43 columns"
    },
    "authority": "SP-05 only PROPOSES actions; sp05_risk.RiskController has final authority over execution"
  }
}